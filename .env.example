# ==========================================
# CONFIGURAÇÕES DO BANCO DE DADOS (MONGODB)
# ==========================================
# Substitua os valores abaixo pelas suas credenciais reais do MongoDB Atlas.
# Lembre-se de substituir caracteres especiais da senha, se houver.
MONGO_URI=mongodb+srv://seu_usuario:sua_senha@seu_cluster.xxxx.mongodb.net/agrotech?retryWrites=true&w=majority